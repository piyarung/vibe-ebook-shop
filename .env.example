# ==============================================================================
# Environment Variables Example for Vibe Coding: E-book Shop
# ==============================================================================
# สำคัญ: คัดลอกไฟล์นี้เป็น .env.local แล้วระบุค่าจริงของคุณ
# ห้าม Commit ไฟล์ .env.local ขึ้น GitHub เด็ดขาด (มีระบุใน .gitignore แล้ว)

# 1. Supabase Configuration (Database & Storage)
# รับค่าได้จาก Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# 2. Gmail SMTP Configuration (แนะนำสำหรับการส่งเข้า Gmail จริงได้ทุกที่)
# สร้าง App Password ได้ที่: https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password

# 3. หรือใช้ Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
